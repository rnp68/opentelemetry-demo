#
# Helm values for the grafana/k8s-monitoring chart (v4.x).
# Generated by the Grafana Cloud "Kubernetes Infrastructure" wizard, then
# cleaned up: trailing dots stripped from URLs, secrets removed (passwords
# are injected by the install script via --set-string).
#
# This file is a TEMPLATE. scripts/grafana-cloud-k8s-monitoring/install.sh renders
# it to build/ with the values of GRAFANA_CLOUD_*_URL and GRAFANA_CLOUD_*_USER
# from .env.local (find them in your Grafana Cloud stack > Kubernetes > Start
# sending data). The token is injected from a separate, temporary values file.
#
# Cluster name is set by the install script via --set-string; do not hardcode
# here, otherwise local + AWS clusters collide in Grafana Cloud.

destinations:
  grafana-cloud-metrics:
    type: prometheus
    url: ${GRAFANA_CLOUD_METRICS_URL}
    auth:
      type: basic
      username: "${GRAFANA_CLOUD_METRICS_USER}"

  grafana-cloud-logs:
    type: loki
    url: ${GRAFANA_CLOUD_LOGS_URL}
    auth:
      type: basic
      username: "${GRAFANA_CLOUD_LOGS_USER}"

  gc-otlp-endpoint:
    type: otlp
    url: ${GRAFANA_OTLP_ENDPOINT}
    protocol: http
    auth:
      type: basic
      username: "${GRAFANA_INSTANCE_ID}"
    metrics:
      enabled: true
    logs:
      enabled: true
    traces:
      enabled: true

  grafana-cloud-profiles:
    type: pyroscope
    url: ${GRAFANA_CLOUD_PROFILES_URL}
    auth:
      type: basic
      username: "${GRAFANA_CLOUD_PROFILES_USER}"

clusterMetrics:
  enabled: true
  collector: alloy-metrics

hostMetrics:
  enabled: true
  collector: alloy-metrics
  linuxHosts:
    enabled: true
  windowsHosts:
    enabled: true
  energyMetrics:
    enabled: true

costMetrics:
  enabled: true
  collector: alloy-metrics

clusterEvents:
  enabled: true
  collector: alloy-singleton

podLogsViaLoki:
  enabled: true
  collector: alloy-logs

applicationObservability:
  enabled: true
  collector: alloy-receiver
  receivers:
    otlp:
      grpc:
        enabled: true
        port: 4317
      http:
        enabled: true
        port: 4318
    zipkin:
      enabled: true
      port: 9411

autoInstrumentation:
  enabled: true
  collector: alloy-metrics
  beyla:
    deliverTracesToApplicationObservability: false

profiling:
  enabled: true
  collector: alloy-profiles
  # Charts >= 4.1.5 refuse "profiling.enabled" without at least one profile type
  # (older charts silently collected nothing). eBPF profiles every process on the
  # node (needs the privileged alloy-profiles daemonset below); Java profiles JVM
  # services such as ad, kafka and fraud-detection.
  ebpf:
    enabled: true
  java:
    enabled: true

collectors:
  alloy-metrics:
    presets:
      - clustered
      - statefulset
  alloy-singleton:
    presets:
      - singleton
  alloy-logs:
    presets:
      - filesystem-log-reader
      - daemonset
  alloy-receiver:
    presets:
      - deployment
  alloy-profiles:
    presets:
      - privileged
      - daemonset

collectorCommon:
  alloy:
    remoteConfig:
      # Disabled: the access policy token needs fleet-management:read/write scopes.
      # To re-enable: add those scopes to the access policy in the Grafana Cloud
      # portal, create a new token, set it as GRAFANA_CLOUD_TOKEN in .env.local and
      # set enabled: true.
      enabled: false

telemetryServices:
  kube-state-metrics:
    deploy: true
  node-exporter:
    deploy: true
  windows-exporter:
    deploy: true
  opencost:
    deploy: true
    metricsSource: grafana-cloud-metrics
    opencost:
      exporter: {}  # defaultClusterId set by install script via --set-string
      prometheus:
        # existingSecretName is set by install script via --set-string —
        # auto-tracks release name as: <destination-name>-<release-name>
        # (e.g. grafana-cloud-metrics-grafana-k8s-monitoring)
        external:
          url: ${GRAFANA_CLOUD_METRICS_QUERY_URL}
  kepler:
    deploy: true
