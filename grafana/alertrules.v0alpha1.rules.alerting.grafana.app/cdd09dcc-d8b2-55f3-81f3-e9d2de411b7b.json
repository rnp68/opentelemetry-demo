          "instant": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": false,
          "refId": "query"
        },
        "queryType": "prometheus",
        "relativeTimeRange": {
          "from": "11m0s",
          "to": "1m0s"
