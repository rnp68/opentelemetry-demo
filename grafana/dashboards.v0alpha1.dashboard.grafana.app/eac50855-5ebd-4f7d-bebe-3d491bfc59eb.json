          },
          {
            "datasource": {
              "type": "mssql",
              "uid": "fejqpycotqvpce"
            },
            "editorMode": "code",
            "format": "table",
            "key": "Q-651b1918-f22b-40ab-ae24-d3b29c90bf83-1",
            "rawQuery": true,
            "rawSql": "SELECT \n    qs.sql_handle,\n    st.text AS query_text,\n    qs.total_worker_time AS cpu_time,\n    qs.total_elapsed_time,\n    qs.total_logical_reads,\n    qs.total_physical_reads,\n    qs.execution_count\nFROM sys.dm_exec_query_stats qs\nCROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) st\nORDER BY qs.total_worker_time DESC;\n",
            "refId": "historic_usage",
            "sql": {
              "columns": [
