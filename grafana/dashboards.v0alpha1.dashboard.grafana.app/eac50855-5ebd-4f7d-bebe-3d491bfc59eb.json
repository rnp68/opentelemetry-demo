            "format": "table",
            "key": "Q-8d34c165-99d7-4cfb-9b4a-7ffee00839ac-2",
            "rawQuery": true,
            "rawSql": "SELECT \n    r.session_id,\n    r.status,\n    r.cpu_time,\n    r.total_elapsed_time,\n    r.logical_reads,\n    r.writes,\n    r.blocking_session_id,\n    t.text AS query_text\nFROM sys.dm_exec_requests r\nCROSS APPLY sys.dm_exec_sql_text(r.sql_handle) t\nORDER BY r.cpu_time DESC;\n",
            "refId": "Stored_procedures",
            "sql": {
              "columns": [
                {
                  "parameters": [],
                  "type": "function"
                }
              ],
              "groupBy": [
                {
                  "property": {
                    "type": "string"
