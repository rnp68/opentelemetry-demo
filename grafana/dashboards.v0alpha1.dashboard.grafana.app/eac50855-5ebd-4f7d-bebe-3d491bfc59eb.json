            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT \n    p.name AS procedure_name,\n    s.name AS schema_name,\n    m.definition AS procedure_definition,\n    p.create_date,\n    p.modify_date,\n    pa.parameter_id,\n    pa.name AS parameter_name,\n    pa.system_type_id,\n    t.name AS data_type,\n    pa.max_length,\n    pa.is_output AS is_output_parameter\nFROM sys.procedures p\nJOIN sys.schemas s ON p.schema_id = s.schema_id\nJOIN sys.sql_modules m ON p.object_id = m.object_id\nLEFT JOIN sys.parameters pa ON p.object_id = pa.object_id\nLEFT JOIN sys.types t ON pa.system_type_id = t.user_type_id\nORDER BY p.name, pa.parameter_id;\n",
            "refId": "Real_time_usage",
            "sql": {
              "columns": [
                {
                  "name": "COUNT",
                  "parameters": [
                    {
                      "name": "",
                      "type": "functionParameter"
