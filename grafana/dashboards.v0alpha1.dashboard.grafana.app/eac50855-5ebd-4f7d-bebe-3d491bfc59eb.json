            }
          },
          {
            "datasource": {
              "type": "mssql",
              "uid": "fejqpycotqvpce"
            },
            "editorMode": "code",
            "format": "table",
            "hide": false,
            "rawQuery": true,
            "rawSql": "SELECT \n    (SELECT COUNT(*) FROM sys.dm_exec_requests) AS active_queries,\n    (SELECT COUNT(*) FROM sys.dm_exec_sessions WHERE is_user_process = 1) AS active_sessions,\n    (SELECT SUM(total_physical_reads) FROM sys.dm_exec_query_stats) AS total_physical_reads,\n    (SELECT SUM(total_logical_reads) FROM sys.dm_exec_query_stats) AS total_logical_reads,\n    (SELECT SUM(total_worker_time) FROM sys.dm_exec_query_stats) / 1000 AS total_cpu_time_ms,\n    (SELECT SUM(wait_time_ms) FROM sys.dm_os_wait_stats) AS total_wait_time_ms,\n    (SELECT SUM(io_stall_read_ms) FROM sys.dm_io_virtual_file_stats(DB_ID(), NULL)) AS io_stall_read_ms,\n    (SELECT SUM(io_stall_write_ms) FROM sys.dm_io_virtual_file_stats(DB_ID(), NULL)) AS io_stall_write_ms\n",
            "refId": "General_performance",
            "sql": {
              "columns": [
                {
                  "parameters": [],
                  "type": "function"
                }
              ],
              "groupBy": [
                {
