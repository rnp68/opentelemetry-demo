{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "Dashboard",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "otel-demo",
      "grafana.app/message": "Created by gcx observability setup"
    },
    "labels": {},
    "name": "otel-k8s-workloads",
    "namespace": "stacks-1036148"
  },
  "spec": {
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "expr": "count(kube_pod_info{namespace=\"otel-demo\"})",
            "legendFormat": "Pods",
            "refId": "A"
          }
        ],
        "title": "Pod Count",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "cores"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        },
        "id": 2,
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "expr": "sum by(pod) (rate(container_cpu_usage_seconds_total{namespace=\"otel-demo\"}[5m]))",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "title": "CPU Usage by Pod",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "bytes"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        },
        "id": 3,
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "expr": "sum by(pod) (container_memory_working_set_bytes{namespace=\"otel-demo\"})",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "title": "Memory by Pod",
        "type": "timeseries"
      }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
      "otel-demo"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "title": "OTel Demo — K8s Workloads"
  }
}
