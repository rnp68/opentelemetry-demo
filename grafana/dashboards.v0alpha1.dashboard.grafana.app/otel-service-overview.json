{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "Dashboard",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "otel-demo",
      "grafana.app/message": "Created by gcx observability setup"
    },
    "labels": {},
    "name": "otel-service-overview",
    "namespace": "stacks-1036148"
  },
  "spec": {
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "unit": "reqps"
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "expr": "sum(rate(http_server_duration_count{namespace=\"otel-demo\"}[5m]))",
            "legendFormat": "RPS",
            "refId": "A"
          }
        ],
        "title": "Total RPS",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.01
                },
                {
                  "color": "red",
                  "value": 0.05
                }
              ]
            },
            "unit": "percentunit"
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "id": 2,
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "expr": "sum(rate(http_server_duration_count{namespace=\"otel-demo\",http_status_code=~\"5..\"}[5m])) / sum(rate(http_server_duration_count{namespace=\"otel-demo\"}[5m]))",
            "legendFormat": "Error Rate",
            "refId": "A"
          }
        ],
        "title": "Error Rate",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        },
        "id": 3,
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "expr": "sum by(job) (rate(http_server_duration_count{namespace=\"otel-demo\"}[5m]))",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "title": "Request Rate by Service",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        },
        "id": 4,
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by(job, le) (rate(http_server_duration_bucket{namespace=\"otel-demo\"}[5m])))",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "title": "p95 Latency by Service",
        "type": "timeseries"
      }
    ],
    "refresh": "30s",
