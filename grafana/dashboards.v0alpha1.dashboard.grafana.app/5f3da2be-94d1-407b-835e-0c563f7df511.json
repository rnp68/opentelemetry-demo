{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "Dashboard",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "ee6qllfxlq41sb"
    },
    "labels": {},
    "name": "5f3da2be-94d1-407b-835e-0c563f7df511",
    "namespace": "stacks-1036148"
  },
  "spec": {
    "annotations": {
      "list": []
    },
    "panels": [
      {
        "datasource": null,
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "gridPos": {
          "h": 12,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "showHeader": true
        },
        "pluginVersion": "9.0.0",
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "expr": "sum by (service_name) (count_over_time({service_name=~\".+\"}[24h]))",
            "legendFormat": "LOGS",
            "refId": "Logs"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "expr": "count by (service_name) (rate({service_name=~\".+\"}[1m]))",
            "legendFormat": "TS",
            "refId": "Metrics"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-traces"
            },
            "expr": "sum by (service_name) (tempo_spanmetrics_latency_count{service_name=~\".+\"})",
            "legendFormat": "TRACES",
            "refId": "Traces"
          }
        ],
        "title": "Telemetry Counts per Service",
        "transformations": [
          {
            "id": "joinByField",
            "options": {
              "joinFields": {},
              "mode": "outer",
              "on": [
                "service_name"
              ]
            }
          },
          {
            "id": "renameByRegex",
            "options": {
              "regex": "^(.*)$",
              "renamePattern": "$1"
            }
          }
        ],
        "type": "table"
      }
    ],
    "refresh": "1m",
    "schemaVersion": 38,
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ]
    },
    "title": "BCP - Telemetry Summary Dashboard"
  }
}
