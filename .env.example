# =============================================================================
# Workshop configuration template.
#
#   cp .env.example .env.local      # then edit .env.local
#
# - .env.example is tracked by git and ships EVERY value as "unknown".
# - .env.local is gitignored and holds your real values and secrets.
# - The upstream .env (demo ports, image versions, ...) is NOT edited by this
#   workshop; .env.local is layered on top of it.
# - A value that is empty or "unknown" is treated as "not set": the scripts then
#   use the built-in default for tunables (listed in scripts/lib/common.sh) or
#   stop with instructions for values that have no safe default.
#
# Documentation of every variable: docs/configuration.md
# =============================================================================

# --- Grafana Cloud: OTLP (traces, metrics, logs from the OpenTelemetry Collector)
# Grafana Cloud portal > your stack > OpenTelemetry > Configure.
GRAFANA_OTLP_ENDPOINT=unknown          # e.g. https://otlp-gateway-<region>.grafana.net/otlp
GRAFANA_INSTANCE_ID=unknown            # numeric OTLP instance ID (basic-auth user)
GRAFANA_CLOUD_APIKEY=unknown           # SECRET. Access policy token with metrics/logs/traces:write

# --- Grafana Faro (browser real-user monitoring). Optional.
# Grafana Cloud > Frontend Observability > create app > "Collector URL".
GRAFANA_FARO_ENDPOINT=unknown

# --- Grafana Pyroscope (continuous profiling of the checkout service). Optional.
# Grafana Cloud portal > your stack > Profiles > Details.
GRAFANA_PYROSCOPE_ADDR=unknown         # e.g. https://profiles-prod-001.grafana.net
GRAFANA_PYROSCOPE_AUTH_USER=unknown
GRAFANA_PYROSCOPE_AUTH_PASS=unknown    # SECRET

# --- Grafana Cloud: Kubernetes monitoring (scripts/grafana-cloud-k8s-monitoring)
# Grafana Cloud portal > your stack > Kubernetes > Start sending data.
GRAFANA_CLOUD_TOKEN=unknown            # SECRET. Access policy token (see docs/grafana-cloud-k8s-monitoring.md)
GRAFANA_CLOUD_METRICS_URL=unknown      # https://prometheus-prod-XX-....grafana.net/api/prom/push
GRAFANA_CLOUD_METRICS_USER=unknown
GRAFANA_CLOUD_LOGS_URL=unknown         # https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOGS_USER=unknown
GRAFANA_CLOUD_PROFILES_URL=unknown     # https://profiles-prod-XXX.grafana.net:443
GRAFANA_CLOUD_PROFILES_USER=unknown
K8S_MONITORING_CHART_VERSION=unknown   # default 4.6.0 (exact, validated by helm template)
K8S_MONITORING_NAMESPACE=unknown       # default grafana-k8s-monitoring
K8S_CLUSTER_NAME=unknown               # default: current kubectl context
GRAFANA_STACK_URL=unknown              # e.g. https://<stack>.grafana.net (only for links and opening the activation page)
GCX_CONTEXT=unknown                    # gcx context of THIS stack; enables the automatic data check after install
K8S_MONITORING_ACTIVATED=unknown       # set to true once you activated Kubernetes Monitoring in the UI (starts billing)
K8S_MONITORING_VERIFY_MINUTES=unknown  # default 6: how long to wait for cluster data after install
K8S_MONITORING_RELEASE=unknown         # default grafana-k8s-monitoring

# --- Kubernetes deployment (Helm)
OTEL_DEMO_CHART_VERSION=unknown        # default 0.37.8 (matches demo 2.0.2 on this branch)
OTEL_DEMO_NAMESPACE=unknown            # default otel-demo
OTEL_DEMO_RELEASE=unknown              # default opentelemetry-demo
K8S_CONTEXT=unknown                    # default: first of orbstack, docker-desktop, minikube that exists
ALLOY_CHART_VERSION=unknown            # default 1.8.1 (grafana/alloy, used by --k8s-alloy-collector)
MINIKUBE_CPUS=unknown                  # default 4
MINIKUBE_MEMORY_MB=unknown             # default 8192

# --- Demo images (Docker Compose). The upstream .env says "latest", which pulls whatever
# upstream published last and no longer matches this branch's compose file.
DEMO_VERSION=unknown                   # default 2.0.2 (same demo version as chart 0.37.8)

# --- Load generator (lean default is 5 users; upstream uses 10)
LOCUST_USERS=unknown

# --- AWS (scripts/deploy-aws.sh, scripts/teardown-aws.sh)
AWS_REGION=unknown                     # default: AWS_DEFAULT_REGION, then aws configure, then us-east-1
EKS_CLUSTER_NAME=unknown               # default otel-demo
EKS_K8S_VERSION=unknown                # default 1.33
EKS_NODE_TYPE=unknown                  # default t3.xlarge
EKS_NODE_COUNT=unknown                 # default 2
EKS_NODE_MIN=unknown                   # default 1
EKS_NODE_MAX=unknown                   # default 4
AWS_RESOURCE_TAG_KEY=unknown           # default project
AWS_RESOURCE_TAG_VALUE=unknown         # default opentelemetry-demo

# --- Grafana-side assets (SLOs, synthetic checks, k6): rendered by scripts/render-assets.sh
DEMO_TARGET_URL=unknown                # URL where the shop is reachable by Grafana Cloud, e.g. http://203.0.113.10:8080
DEMO_ENVIRONMENT=unknown               # label value, default workshop
GRAFANA_CLOUD_PROM_DATASOURCE_UID=unknown   # default grafanacloud-prom
